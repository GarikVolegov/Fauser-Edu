# Fauser-Edu — environment variables (template).
# Copy to .env.local and fill in real values. .env.local is git-ignored.

# --- Database (Postgres) ---
# Local dev uses embedded-postgres (see: node scripts/dev-db.mjs start)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fauser

# --- Auth (Clerk) — get keys at https://dashboard.clerk.com ---
# Backend
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Frontend (Vite, must be prefixed VITE_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional: Clerk proxy URL (leave empty for local dev)
# VITE_CLERK_PROXY_URL=

# --- Email encryption (AES-256) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Dev ports (used by the run scripts) ---
# Backend API listens on API_PORT; frontend Vite on WEB_PORT.
API_PORT=8080
WEB_PORT=3000
BASE_PATH=/
